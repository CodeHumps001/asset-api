DATABASE_URL="postgresql://ict:ict_password@localhost:5432/ict_assets?schema=public"
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d
APP_URL=http://localhost:3000
INVITATION_EXPIRY_HOURS=48
MAINTENANCE_REMINDER_DAYS=7

# ---------- Email via Brevo ----------
# Create an API key under SMTP & API > API Keys.
BREVO_API_KEY=
# This address must be verified in Brevo (Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com
BREVO_SENDER_NAME="ICT Asset Management"

# Without an API key, emails print to the backend console in development only.
